  "narrative": {
    "northStar": "The Site Office",
    "overview": "The Devis AI dashboard is a well-kept site office: tidy, practical, with nothing on the walls that serves no purpose. Cool neutral palette, a single building-trade orange, near-flat depth, calm and precise density.",
    "keyCharacteristics": ["A single accent colour, orange (#ea580c), and a rare one.","Borders before shadows; flat surfaces at rest.","Inter throughout, medium weights, tabular figures for amounts.","Status pills with a pale wash and dark text, never solid fills.","Short, reduced-motion-aware transitions with an \"expo out\" easing."],
    "rules": [
      { "name": "The Single Signal Rule", "body": "Orange marks the main action and where you are. One solid orange button per view at most; never as a large background.", "section": "colors" },
      { "name": "The Aligned Figures Rule", "body": "Every amount or count uses tabular-nums and aligns right in tables, with breakable thousands spaces.", "section": "typography" },
      { "name": "The Border First Rule", "body": "A level separates with a border before a shadow. A clickable tile reacts by darkening its border (#cbd5e1), not by lifting.", "section": "elevation" }
    ],
    "dos": ["Do reserve #ea580c for the main action, the active marker and key links.","Do separate surfaces with 1px #e2e8f0 borders and keep the Card shadow almost invisible.","Do use tabular-nums and right alignment for every amount.","Do express statuses as pale-wash badges with dark text.","Do respect prefers-reduced-motion.","Do keep the 2px orange focus ring offset by 2px on every interactive element."],
    "donts": ["Don't use orange as a large background or as body text.","Don't stack heavy shadows or lift app cards on hover.","Don't introduce a second font or a second accent colour.","Don't use bold (700) in the app; 500 and 600 are enough."]
  }
